#include <Wire.h>
#include <LiquidCrystal_I2C.h>

LiquidCrystal_I2C lcd(0x27, 16, 2);   // si no funciona, prueba 0x3F

const int PIN_ADC = 34;   // entrada analógica (salida del LM331)
// I2C: SDA = 21, SCL = 22

const float V_MIN = 1.4;
const float V_MED = 1.9;
const float V_MAX = 2.3;

// Si usas divisor de voltaje antes del pin (ej. 10k + 10k), pon 2.0
const float FACTOR_DIVISOR = 1.0;

void setup() {
  Serial.begin(115200);
  analogReadResolution(12);                     // 0-4095
  analogSetPinAttenuation(PIN_ADC, ADC_11db);   // rango ~0-3.3 V

  Wire.begin(21, 22);
  lcd.init();
  lcd.backlight();
  lcd.setCursor(0, 0);
  lcd.print("Sensor capacit.");
  delay(1000);
  lcd.clear();
}

float leerVoltaje() {
  long suma = 0;
  for (int i = 0; i < 32; i++) suma += analogRead(PIN_ADC);  // promedio
  return (suma / 32.0) * 3.3 / 4095.0 * FACTOR_DIVISOR;
}

void loop() {
  float v = leerVoltaje();

  // Nivel según los umbrales (solo para mostrar)
  const char* nivel;
  if (v < V_MIN)       nivel = "Bajo rango";
  else if (v < V_MED)  nivel = "Minimo-Medio";
  else if (v <= V_MAX) nivel = "Medio-Maximo";
  else                 nivel = "Sobre rango";

  lcd.setCursor(0, 0);
  lcd.printf("V: %.2f V     ", v);
  lcd.setCursor(0, 1);
  lcd.printf("%-16s", nivel);

  Serial.printf("V = %.2f V  (%s)\n", v, nivel);
  delay(100);
}




