C = [70 80 86 89 91 99 102 117 120 121];

V_subida = [2.059 1.993 1.910 1.920 1.901 ...
            1.820 1.838 1.826 1.798 1.787];

V_bajada = [2.074 2.007 1.940 1.930 1.923 ...
            1.830 1.860 1.844 1.820 1.806];


%% REGRESIONES

p_subida = polyfit(C,V_subida,1);
p_bajada = polyfit(C,V_bajada,1);

Vreg_subida = polyval(p_subida,C);
Vreg_bajada = polyval(p_bajada,C);


%% R2

R2_subida = 1 - sum((V_subida-Vreg_subida).^2) / ...
                sum((V_subida-mean(V_subida)).^2);

R2_bajada = 1 - sum((V_bajada-Vreg_bajada).^2) / ...
                sum((V_bajada-mean(V_bajada)).^2);


%% ERRORES DE LINEALIDAD

error_subida = abs(V_subida-Vreg_subida);
error_bajada = abs(V_bajada-Vreg_bajada);

error_max_subida = max(error_subida);
error_max_bajada = max(error_bajada);

span = max([V_subida V_bajada]) - ...
       min([V_subida V_bajada]);

linealidad_subida = error_max_subida/span*100;
linealidad_bajada = error_max_bajada/span*100;


%% ERRORES PROMEDIO

error_promedio_subida = mean(error_subida);
error_promedio_bajada = mean(error_bajada);

error_promedio_general = ...
    mean([error_subida error_bajada]);

error_promedio_general_pct = ...
    error_promedio_general/span*100;


%% HISTERESIS

H = abs(V_bajada-V_subida);

[H_max,indice_max] = max(H);

H_min = min(H);
H_prom = mean(H);

C_Hmax = C(indice_max);
V_Hmax_subida = V_subida(indice_max);
V_Hmax_bajada = V_bajada(indice_max);

H_max_pct = H_max/span*100;
H_prom_pct = H_prom/span*100;


%% SENSIBILIDAD

